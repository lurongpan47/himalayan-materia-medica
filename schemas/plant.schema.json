{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Himalayan Materia Medica · Plant Entry",
  "type": "object",
  "required": ["id", "scientific_name", "family", "names", "sources"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "slug = lowercase genus_species, matches filename"
    },
    "scientific_name": {
      "type": "object",
      "required": ["binomial"],
      "properties": {
        "binomial": {"type": "string"},
        "authority": {"type": ["string", "null"]},
        "synonyms": {"type": "array", "items": {"type": "string"}}
      }
    },
    "family": {"type": "string"},
    "genus": {"type": "string"},
    "names": {
      "type": "object",
      "properties": {
        "zh": {
          "type": ["string", "object", "null"],
          "description": "中文正名 or {primary: ..., aliases: [...]}"
        },
        "bo": {
          "type": ["object", "null"],
          "properties": {
            "unicode": {"type": ["string", "null"]},
            "wylie": {"type": ["string", "null"]},
            "aliases": {"type": "array", "items": {"type": "object"}}
          }
        },
        "en": {"type": "array", "items": {"type": "string"}},
        "sa": {
          "type": ["object", "null"],
          "properties": {
            "devanagari": {"type": ["string", "null"]},
            "iast": {"type": ["string", "null"]}
          }
        },
        "ne": {"type": ["string", "null"], "description": "Nepali name if known"},
        "local": {"type": "array", "items": {"type": "object"}}
      }
    },
    "distribution": {
      "type": "object",
      "properties": {
        "elevation_m": {
          "type": ["object", "null"],
          "properties": {"min": {"type": "integer"}, "max": {"type": "integer"}}
        },
        "regions": {"type": "array", "items": {"type": "string"}},
        "habitat": {"type": ["string", "null"]},
        "gbif_taxon_key": {"type": ["integer", "null"]}
      }
    },
    "morphology": {"type": ["string", "null"]},
    "parts_used": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["root", "rhizome", "whole_plant", "aerial_parts", "leaves", "flower", "fruit", "seed", "bark", "resin", "latex", "stigma", "bulb", "tuber"]
      }
    },
    "uses_historical": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system", "source_ref"],
        "properties": {
          "system": {
            "type": "string",
            "enum": ["tibetan_sowa_rigpa", "ayurveda", "tcm", "unani", "nepalese_traditional", "ethnobotany"]
          },
          "source_ref": {"type": ["string", "null"], "description": "Key into data/sources/*.yml; null when no classical source exists"},
          "volume": {"type": ["string", "null"]},
          "chapter": {"type": ["string", "integer", "null"]},
          "page": {"type": ["string", "null"]},
          "text_original": {"type": ["string", "null"]},
          "text_translation": {"type": ["string", "null"]},
          "translator": {"type": ["string", "null"]},
          "review_status": {
            "type": "string",
            "enum": ["ai_draft", "reviewed_pending", "reviewed_approved"],
            "default": "ai_draft"
          }
        }
      }
    },
    "chemistry": {
      "type": "object",
      "properties": {
        "key_compounds": {"type": "array", "items": {"type": "object"}},
        "pubchem_cids": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "conservation": {
      "type": "object",
      "properties": {
        "iucn_status": {"type": ["string", "null"]},
        "cites_appendix": {"type": ["string", "null"]},
        "china_national_protection": {"type": ["string", "null"]}
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "license", "credit"],
        "properties": {
          "path": {"type": "string", "description": "data/images/<slug>/<file>"},
          "caption": {"type": ["string", "null"]},
          "license": {
            "type": "string",
            "enum": ["public_domain", "cc0", "cc_by_4", "cc_by_sa_4", "cc_by_3", "cc_by_sa_3", "project_cc_by_sa_4"]
          },
          "credit": {"type": "string"},
          "source_url": {"type": ["string", "null"]},
          "type": {
            "type": "string",
            "enum": ["photo_wild", "photo_cultivated", "herbarium_specimen", "botanical_illustration", "line_drawing"]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "retrieved"],
        "properties": {
          "key": {"type": "string", "description": "Key into data/sources/*.yml"},
          "retrieved": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["stub", "draft", "reviewed_pending", "reviewed_approved", "deprecated"],
      "default": "stub"
    },
    "last_updated": {"type": ["string", "null"]}
  }
}
